# Supabase 적재 설정 — 이 파일을 복사해 ".env" 로 만들고 값을 채우세요.
#   (.env 는 git에 올라가지 않습니다. 키/비밀번호를 여기에 넣어도 안전)

# ── 방식 1 (권장): Postgres 직접 연결 ──
# Supabase 대시보드 > Project Settings > Database > Connection string > URI
# 예: postgresql://postgres.xxxx:[비밀번호]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres
DATABASE_URL=

# ── 방식 2 (대체): REST API ──
# 위 DATABASE_URL 이 비어 있을 때만 사용됩니다.
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
