# Supabase 적재 설정 — 이 파일을 복사해 ".env" 로 만들고 값을 채우세요.
#   (.env 는 git에 올라가지 않습니다. 키를 여기에 넣어도 안전)

# ── REST API 방식 (권장) ──
# Direct DB 접속(db.xxxx.supabase.co)은 IPv6 전용이라 일부 네트워크에서 접속이
# 안 될 수 있습니다. REST API는 일반 HTTPS라 이런 문제가 없습니다.
# Supabase 대시보드 > Project Settings > API 에서 확인
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── 대체: Postgres 직접 연결 (Session/Transaction Pooler 권장) ──
# SUPABASE_DATABASE_URL=postgresql://postgres.xxxx:[비밀번호]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres
